                  "if (id) pm.environment.set('clientId', id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Northwind Clinics\",\n  \"slug\": \"northwind-clinics\",\n  \"contactEmail\": \"it@northwind.example\",\n  \"user\": {\n    \"name\": \"Northwind Admin\",\n    \"email\": \"client@northwind.example\",\n    \"password\": \"ChangeMe123!\"\n  }\n}"
            },
            "url": "{{backendUrl}}/api/clients"
          }
        }
